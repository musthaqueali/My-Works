      </div>
    </div>
  </footer>

  <!-- ====================================================================== -->
  <!-- MODAL: Authentication (Sign In / Sign Up)                             -->
  <!-- ====================================================================== -->
  <div class="modal-backdrop" id="modal-auth" style="display: none;" onclick="handleBackdropClick(event, 'modal-auth')">
    <div class="modal-dialog modal-dialog-sm" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="auth-icon-badge">
            <i data-lucide="user-check" style="width: 20px; height: 20px; color: var(--zapier-orange);"></i>
          </div>
          <div>
            <h3 class="modal-title" id="auth-modal-title">Welcome to I LOVE FILES</h3>
            <p class="modal-subtitle" id="auth-modal-subtitle">Sign in or create an account for free conversions</p>
          </div>
        </div>
        <button type="button" class="modal-close-btn" onclick="closeModal('modal-auth')" aria-label="Close modal">
          <i data-lucide="x" style="width: 18px; height: 18px;"></i>
        </button>
      </div>

      <!-- Tab Switcher -->
      <div class="auth-tab-switch">
        <button type="button" class="auth-tab-pill active" id="auth-tab-signin-btn" onclick="switchAuthTab('signin')">Sign In</button>
        <button type="button" class="auth-tab-pill" id="auth-tab-signup-btn" onclick="switchAuthTab('signup')">Create Account</button>
      </div>

      <!-- Google One-Click Sign-In -->
      <div class="google-auth-container">
        <button type="button" class="btn-google-auth" id="btn-google-auth" onclick="triggerGoogleSignIn()">
          <svg class="google-icon" width="18" height="18" viewBox="0 0 48 48">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          <span id="google-btn-text">Continue with Google</span>
        </button>
        <div id="google-native-btn-wrap" style="display: none;"></div>
      </div>

      <div class="auth-divider">
        <span>or continue with email</span>
      </div>

      <!-- Dynamic Error Banner -->
      <div id="auth-error-msg" class="auth-error-alert" style="display: none;"></div>

      <!-- Sign In Form -->
      <form id="auth-signin-form" onsubmit="handleSignInSubmit(event)" autocomplete="on">
        <div class="form-group-saas">
          <label class="form-label-saas" for="auth-signin-email">Email Address</label>
          <input type="email" id="auth-signin-email" name="email" class="form-input-saas" placeholder="alex@company.com" required autocomplete="username">
        </div>
        <div class="form-group-saas">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
            <label class="form-label-saas" for="auth-signin-password" style="margin-bottom: 0;">Password</label>
          </div>
          <input type="password" id="auth-signin-password" name="password" class="form-input-saas" placeholder="••••••••••••" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-ember btn-saas-block" id="btn-submit-signin">
          <span>Sign In</span>
          <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
        </button>
      </form>

      <!-- Sign Up Form -->
      <form id="auth-signup-form" onsubmit="handleSignUpSubmit(event)" autocomplete="on" style="display: none;">
        <div class="form-group-saas">
          <label class="form-label-saas" for="auth-signup-name">Full Name</label>
          <input type="text" id="auth-signup-name" name="name" class="form-input-saas" placeholder="Alex Morgan" required autocomplete="name">
        </div>
        <div class="form-group-saas">
          <label class="form-label-saas" for="auth-signup-email">Email Address</label>
          <input type="email" id="auth-signup-email" name="email" class="form-input-saas" placeholder="alex@company.com" required autocomplete="email">
        </div>
        <div class="form-group-saas">
          <label class="form-label-saas" for="auth-signup-password">Password</label>
          <input type="password" id="auth-signup-password" name="password" class="form-input-saas" placeholder="At least 8 characters" minlength="8" required autocomplete="new-password">
          <span class="form-hint">Must be at least 8 characters long</span>
        </div>
        <button type="submit" class="btn btn-ember btn-saas-block" id="btn-submit-signup">
          <span>Create Free Account</span>
          <i data-lucide="check" style="width: 16px; height: 16px;"></i>
        </button>
      </form>

      <div class="auth-modal-footer">
        <span>By continuing you agree to our 100% private, local-first terms. No cloud data harvesting.</span>
      </div>
    </div>
  </div>

  <!-- ====================================================================== -->
  <!-- MODAL: Pricing Plans & Subscriptions                                  -->
  <!-- ====================================================================== -->
  <div class="modal-backdrop" id="modal-pricing" style="display: none;" onclick="handleBackdropClick(event, 'modal-pricing')">
    <div class="modal-dialog modal-dialog-lg" role="dialog" aria-modal="true" aria-labelledby="pricing-modal-title">
      <div class="modal-header">
        <div>
          <div class="saas-badge-pill" style="margin-bottom: 0.5rem;">
            <i data-lucide="zap" style="width: 13px; height: 13px; color: var(--zapier-orange);"></i>
            <span>TRANSPARENT, ZERO-SURPRISE PRICING</span>
          </div>
          <h2 class="modal-title" id="pricing-modal-title" style="font-size: 1.5rem; font-weight: 700;">Simple Pricing for Professionals</h2>
          <p class="modal-subtitle">Pick the plan that powers your document and CAD workflow. Upgrade or cancel anytime.</p>
        </div>
        <button type="button" class="modal-close-btn" onclick="closeModal('modal-pricing')" aria-label="Close modal">
          <i data-lucide="x" style="width: 18px; height: 18px;"></i>
        </button>
      </div>

      <!-- Billing Cycle Toggle (Monthly vs Annual) -->
      <div class="pricing-toggle-wrap">
        <span class="billing-cycle-label active" id="label-cycle-monthly">Monthly Billing</span>
        <button type="button" class="billing-toggle-switch" id="billing-cycle-switch" onclick="toggleBillingCycle()" aria-label="Toggle Monthly or Annual Billing">
          <span class="billing-toggle-thumb"></span>
        </button>
        <span class="billing-cycle-label" id="label-cycle-annual">
          Annual Billing
          <span class="discount-chip">SAVE 20%</span>
        </span>
      </div>

      <!-- Pricing Cards 3-Column Grid -->
      <div class="pricing-cards-grid">
        
        <!-- FREE TIER -->
        <div class="pricing-card" id="card-tier-free">
          <div class="pricing-card-header">
            <h4 class="plan-name">Free Starter</h4>
            <p class="plan-desc">For casual users and occasional document conversion.</p>
            <div class="plan-price-wrap">
              <span class="plan-price">₹0</span>
              <span class="plan-period">/ month</span>
            </div>
          </div>
          <ul class="plan-features">
            <li><i data-lucide="check" class="feat-check"></i><span><strong>5 free conversions</strong> per day</span></li>
            <li><i data-lucide="check" class="feat-check"></i><span>Max file size: <strong>25 MB</strong></span></li>
            <li><i data-lucide="check" class="feat-check"></i><span>All 45+ formats supported</span></li>
            <li><i data-lucide="check" class="feat-check"></i><span>Standard conversion speed</span></li>
            <li><i data-lucide="check" class="feat-check"></i><span>100% Private local processing</span></li>
            <li class="feat-disabled"><i data-lucide="minus" class="feat-dash"></i><span>AutoCAD Batch Plotting</span></li>
            <li class="feat-disabled"><i data-lucide="minus" class="feat-dash"></i><span>Developer API access</span></li>
          </ul>
          <div class="pricing-card-footer">
            <button class="btn btn-secondary btn-saas-block" id="btn-plan-free" onclick="handleFreePlanAction()">Current Plan</button>
          </div>
        </div>

        <!-- PRO TIER (Featured) -->
        <div class="pricing-card popular" id="card-tier-pro">
          <div class="popular-ribbon">
            <i data-lucide="sparkles" style="width: 12px; height: 12px;"></i>
            <span>RECOMMENDED</span>
          </div>
          <div class="pricing-card-header">
            <h4 class="plan-name">Pro Professional</h4>
            <p class="plan-desc">For architects, engineers, designers &amp; high-volume teams.</p>
            <div class="plan-price-wrap">
              <span class="plan-price" id="price-pro-amt">₹499</span>
              <span class="plan-period" id="price-pro-sub">/ month</span>
            </div>
            <div class="annual-subtext" id="price-pro-annual-sub" style="display: none;">Billed annually as ₹3,999/year (Save ₹1,989)</div>
          </div>
          <ul class="plan-features">
            <li><i data-lucide="check" class="feat-check"></i><span><strong>Unlimited</strong> daily conversions</span></li>
            <li><i data-lucide="check" class="feat-check"></i><span>Max file size: <strong>500 MB</strong></span></li>
            <li><i data-lucide="check" class="feat-check"></i><span><strong>AutoCAD DWG/DXF Batch Plotting</strong></span></li>
            <li><i data-lucide="check" class="feat-check"></i><span><strong>Custom CTB Plot Style Tables</strong></span></li>
            <li><i data-lucide="check" class="feat-check"></i><span><strong>Ultra-HD 600 DPI Print Vectors</strong></span></li>
            <li><i data-lucide="check" class="feat-check"></i><span><strong>PDF Redaction &amp; AES-256 Encryption</strong></span></li>
            <li><i data-lucide="check" class="feat-check"></i><span><strong>Fast Priority Processing Queue</strong></span></li>
            <li><i data-lucide="check" class="feat-check"></i><span><strong>Developer REST API Access</strong></span></li>
          </ul>
          <div class="pricing-card-footer">
            <button class="btn btn-ember btn-saas-block" id="btn-plan-pro" onclick="startCheckout('pro')">
              <span>Upgrade to Pro</span>
              <i data-lucide="zap" style="width: 16px; height: 16px;"></i>
            </button>
            <button class="btn btn-ghost-nav btn-saas-block" style="margin-top: 0.5rem; font-size: 0.78rem; justify-content: center; width: 100%;" onclick="instantDemoUpgrade('pro')">
              <i data-lucide="sparkles" style="width: 13px; height: 13px;"></i>
              <span>Instant 30-Day Pro Trial (Demo / Sandbox)</span>
            </button>
          </div>
        </div>

        <!-- ENTERPRISE TIER -->
        <div class="pricing-card" id="card-tier-enterprise">
          <div class="pricing-card-header">
            <h4 class="plan-name">Enterprise</h4>
            <p class="plan-desc">For engineering firms and organizations needing dedicated scale.</p>
            <div class="plan-price-wrap">
              <span class="plan-price" id="price-enterprise-amt">₹1,999</span>
              <span class="plan-period" id="price-enterprise-sub">/ month</span>
            </div>
            <div class="annual-subtext" id="price-enterprise-annual-sub" style="display: none;">Billed annually as ₹15,999/year</div>
          </div>
          <ul class="plan-features">
            <li><i data-lucide="check" class="feat-check"></i><span>Everything included in <strong>Pro</strong></span></li>
            <li><i data-lucide="check" class="feat-check"></i><span><strong>Unlimited</strong> file size processing</span></li>
            <li><i data-lucide="check" class="feat-check"></i><span>Dedicated conversion workers</span></li>
            <li><i data-lucide="check" class="feat-check"></i><span>Custom CTB font &amp; xref auto-loading</span></li>
            <li><i data-lucide="check" class="feat-check"></i><span>Automated Webhook callbacks</span></li>
            <li><i data-lucide="check" class="feat-check"></i><span>99.9% Uptime SLA guarantee</span></li>
            <li><i data-lucide="check" class="feat-check"></i><span>Direct priority developer support</span></li>
          </ul>
          <div class="pricing-card-footer">
            <button class="btn btn-secondary btn-saas-block" id="btn-plan-enterprise" onclick="startCheckout('enterprise')">
              <span>Choose Enterprise</span>
            </button>
          </div>
        </div>

      </div>

      <!-- Test / Cashfree Notice -->
      <div class="saas-demo-banner">
        <i data-lucide="shield-check" style="width: 16px; height: 16px; flex-shrink: 0; color: var(--zapier-orange);"></i>
        <span><strong>Cashfree Payments Gateway:</strong> Instant checkout supporting UPI (Google Pay, PhonePe, Paytm), Debit/Credit Cards, and Net Banking.</span>
      </div>
    </div>
  </div>

  <!-- ====================================================================== -->
  <!-- MODAL: Daily Quota Limit Alert                                         -->
  <!-- ====================================================================== -->
  <div class="modal-backdrop" id="modal-quota-limit" style="display: none;" onclick="handleBackdropClick(event, 'modal-quota-limit')">
    <div class="modal-dialog modal-dialog-sm modal-center-content" role="dialog" aria-modal="true">
      <div class="quota-limit-icon-circle">
        <i data-lucide="alert-circle" style="width: 32px; height: 32px; color: var(--zapier-orange);"></i>
      </div>
      <h3 class="modal-title" style="font-size: 1.35rem; margin-top: 1rem; margin-bottom: 0.5rem;" id="quota-limit-title">Daily Conversion Limit Reached</h3>
      <p class="modal-subtitle" style="text-align: center; margin-bottom: 1.5rem;" id="quota-limit-msg">
        You have reached your daily free conversion limit. Upgrade to <strong>Pro</strong> for unlimited daily conversions, 500MB uploads, and AutoCAD batch plotting.
      </p>
      <div style="display: flex; flex-direction: column; gap: 0.75rem; width: 100%;">
        <button class="btn btn-ember btn-saas-block" onclick="closeModal('modal-quota-limit'); openPricingModal();">
          <i data-lucide="zap" style="width: 16px; height: 16px;"></i>
          <span>Upgrade to Pro (Unlimited)</span>
        </button>
        <button class="btn btn-secondary btn-saas-block" id="quota-modal-signin-btn" onclick="closeModal('modal-quota-limit'); openAuthModal('signin');">
          <span>Sign In to Existing Account</span>
        </button>
        <button class="btn btn-ghost-nav" style="justify-content: center;" onclick="closeModal('modal-quota-limit')">
          Maybe Later
        </button>
      </div>
    </div>
  </div>

  <!-- ====================================================================== -->
  <!-- MODAL: Developer API Key                                               -->
  <!-- ====================================================================== -->
  <div class="modal-backdrop" id="modal-api-key" style="display: none;" onclick="handleBackdropClick(event, 'modal-api-key')">
    <div class="modal-dialog modal-dialog-md" role="dialog" aria-modal="true" aria-labelledby="api-key-modal-title">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="auth-icon-badge">
            <i data-lucide="code" style="width: 20px; height: 20px; color: var(--zapier-orange);"></i>
          </div>
          <div>
            <h3 class="modal-title" id="api-key-modal-title">Developer REST API</h3>
            <p class="modal-subtitle">Automate your file conversions from Python, Node.js, or cURL</p>
          </div>
        </div>
        <button type="button" class="modal-close-btn" onclick="closeModal('modal-api-key')" aria-label="Close modal">
          <i data-lucide="x" style="width: 18px; height: 18px;"></i>
        </button>
      </div>

      <div class="form-group-saas" style="margin-top: 1rem;">
        <label class="form-label-saas">Your Secret API Key</label>
        <div style="display: flex; gap: 0.5rem;">
          <input type="text" id="user-api-key-input" class="form-input-saas" readonly style="font-family: var(--font-mono); font-size: 0.85rem;" value="Sign in to view your API Key">
          <button type="button" class="btn btn-secondary" onclick="copyApiKey()" id="btn-copy-api-key" style="white-space: nowrap;">
            <i data-lucide="copy" style="width: 15px; height: 15px;"></i>
            <span>Copy</span>
          </button>
        </div>
      </div>

      <div style="margin-top: 1.25rem;">
        <label class="form-label-saas">Example cURL Request</label>
        <div class="code-snippet-box">
          <pre><code>curl -X POST https://your-domain.com/api/convert \
  -H "X-API-Key: <span id="curl-key-placeholder">YOUR_API_KEY</span>" \
  -F "file=@floorplan.dwg" \
  -F "target_format=pdf"</code></pre>
        </div>
      </div>

      <div style="margin-top: 1.5rem; text-align: right;">
        <button type="button" class="btn btn-secondary" onclick="closeModal('modal-api-key')">Close</button>
      </div>
    </div>
  </div>

  <!-- ====================================================================== -->
  <!-- MODAL: Privacy Policy & Data Protection (Local-First Guarantee)        -->
  <!-- ====================================================================== -->
  <div class="modal-backdrop" id="modal-privacy" style="display: none;" onclick="handleBackdropClick(event, 'modal-privacy')">
    <div class="modal-dialog modal-dialog-lg" role="dialog" aria-modal="true" aria-labelledby="privacy-modal-title">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="auth-icon-badge" style="background: rgba(16, 185, 129, 0.12); color: #059669;">
            <i data-lucide="shield-check" style="width: 22px; height: 22px;"></i>
          </div>
          <div>
            <h3 class="modal-title" id="privacy-modal-title">Privacy Policy &amp; Security Guarantee</h3>
            <p class="modal-subtitle">100% In-Browser Isolation • Zero Cloud Telemetry • Compliant with Global Privacy</p>
          </div>
        </div>
        <button type="button" class="modal-close-btn" onclick="closeModal('modal-privacy')" aria-label="Close modal">
          <i data-lucide="x" style="width: 18px; height: 18px;"></i>
        </button>
      </div>

      <div class="privacy-modal-body" style="max-height: 60vh; overflow-y: auto; padding-right: 0.5rem; display: flex; flex-direction: column; gap: 1.25rem; font-size: 0.88rem; line-height: 1.6; color: var(--text-ink);">
        <div>
          <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--forest-main);">1. Architectural Overview &amp; Local Execution</h4>
          <p style="color: var(--text-muted);">
            ILOVEFILES is engineered with a strict <strong>local-first architectural paradigm</strong>. When converting, splitting, compressing, or plotting files, all parsing and vector transformations occur directly inside your browser sandbox using WebAssembly (WASM SIMD) or your connected local AutoCAD Core Console. Your documents, CAD drawings, spreadsheets, and private intellectual property never leave your machine without your explicit request.
          </p>
        </div>

        <div>
          <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--forest-main);">2. Zero Cloud Data Retention &amp; Auto-Purging</h4>
          <p style="color: var(--text-muted);">
            For complex multi-sheet batch plotting that utilizes our backend AutoCAD console daemon, all staged temporary drawing files and generated outputs are kept strictly in ephemeral storage isolated to your session ID and automatically purged within 10 minutes. We maintain zero archival copies, zero backups of your drawings, and zero permanent cloud retention.
          </p>
        </div>

        <div>
          <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--forest-main);">3. Cookies &amp; Local Browser Storage</h4>
          <p style="color: var(--text-muted);">
            We use strictly necessary cookies and browser LocalStorage to remember your user interface settings (such as Light or Dark theme preference), store your accepted cookie consent status, and preserve authenticated session tokens. We never load third-party ad trackers, cross-site beacons, or marketing cookies.
          </p>
        </div>

        <div>
          <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--forest-main);">4. Payment Processing Security</h4>
          <p style="color: var(--text-muted);">
            Subscriptions and one-off PRO upgrades are processed through Cashfree Payments Gateway using bank-grade 256-bit SSL encryption. We never store, process, or have access to your credit card numbers, UPI PINs, or bank account credentials.
          </p>
        </div>

        <div>
          <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--forest-main);">5. Contact &amp; Data Rights</h4>
          <p style="color: var(--text-muted);">
            Designed, engineered, and maintained by <strong>Musthaque Ali</strong>. You retain 100% intellectual property ownership of any file converted or processed using ILOVEFILES.
          </p>
        </div>
      </div>

      <div style="margin-top: 1.5rem; display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--border-ash); padding-top: 1rem;">
        <button type="button" class="btn btn-primary-nav" onclick="closeModal('modal-privacy')">I Understand &amp; Agree</button>
      </div>
    </div>
  </div>

  <!-- ====================================================================== -->
  <!-- COOKIE CONSENT BANNER WINDOW                                            -->
  <!-- ====================================================================== -->
  <div id="cookie-consent-banner" class="cookie-banner-wrap" style="display: none;">
    <div class="cookie-banner-content">
      <div class="cookie-banner-icon">
        <i data-lucide="cookie" style="width: 22px; height: 22px; color: var(--terracotta, #ea580c);"></i>
      </div>
      <div class="cookie-banner-text">
        <div class="cookie-banner-title">Cookie &amp; Local Storage Notice</div>
        <p class="cookie-banner-desc">
          We use strictly functional cookies and local memory to guarantee fast conversions, preserve your theme, and safeguard private local-first processing. No third-party ad tracking.
        </p>
      </div>
      <div class="cookie-banner-actions">
        <button type="button" class="cookie-btn cookie-btn-policy" onclick="openModal('modal-privacy')">Read Policy</button>
        <button type="button" class="cookie-btn cookie-btn-accept" onclick="acceptCookieConsent()">Accept &amp; Continue</button>
      </div>
    </div>
  </div>

  <!-- Cashfree Checkout SDK v3 -->
  <script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>
  <!-- Google Identity Services SDK -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <script src="/static/app.js"></script>
  <script src="/static/broadsheet-speed.js"></script>
</body>
</html>
