        <button type="button" class="auth-tab-pill active" id="auth-tab-signin-btn" onclick="switchAuthTab('signin')">Sign In</button>
        <button type="button" class="auth-tab-pill" id="auth-tab-signup-btn" onclick="switchAuthTab('signup')">Create Account</button>
      </div>

      <!-- Google One-Click Sign-In -->
      <div class="google-auth-container">
        <button type="button" class="btn-google-auth" id="btn-google-auth" onclick="triggerGoogleSignIn()">
          <svg class="google-icon" width="18" height="18" viewBox="0 0 48 48">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          <span id="google-btn-text">Continue with Google</span>
        </button>
        <div id="google-native-btn-wrap" style="display: none;"></div>
      </div>

      <div class="auth-divider">
        <span>or continue with email</span>
      </div>

      <!-- Dynamic Error Banner -->
      <div id="auth-error-msg" class="auth-error-alert" style="display: none;"></div>

      <!-- Sign In Form -->
      <form id="auth-signin-form" onsubmit="handleSignInSubmit(event)" autocomplete="on">
        <div class="form-group-saas">
          <label class="form-label-saas" for="auth-signin-email">Email Address</label>
          <input type="email" id="auth-signin-email" name="email" class="form-input-saas" placeholder="alex@company.com" required autocomplete="username">
        </div>
        <div class="form-group-saas">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
            <label class="form-label-saas" for="auth-signin-password" style="margin-bottom: 0;">Password</label>
          </div>
          <input type="password" id="auth-signin-password" name="password" class="form-input-saas" placeholder="••••••••••••" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-ember btn-saas-block" id="btn-submit-signin">
          <span>Sign In</span>
          <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
        </button>
      </form>

      <!-- Sign Up Form -->
