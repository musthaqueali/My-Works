let currentMountedView = null;

function navigateTo(path, pushState = true) {
  if (pushState && window.location.pathname !== path) {
    try {
      window.history.pushState({ path }, '', path);
    } catch (e) {}
  }
  handleRoute();
}

function handleRoute() {
  const rawPath = window.location.pathname.toLowerCase().replace(/\/+$/, '') || '/';
  const hash = window.location.hash.toLowerCase();

  // Hash navigation
  if (hash === '#studio-bento' || hash === '#convert') {
    switchTab('convert', false);
    return;
  } else if (hash === '#plot' || hash === '#autocad-plot') {
    switchTab('plot', true);
    return;
  } else if (hash === '#merge') {
    switchTab('merge', true);
    return;
  } else if (hash === '#resize' || hash === '#compress') {
    switchTab('resize', true);
    return;
  }

  // If root or unknown route, ensure default title and convert tab
  if (rawPath === '/' || rawPath === '' || !DEDICATED_TOOL_CONFIGS[rawPath]) {
    document.title = 'I LOVE FILES — Fast, Private File Converter & CAD Studio (Made by Musthaque Ali)';
    return;
  }

  // Dedicated tool route mapping
  const config = DEDICATED_TOOL_CONFIGS[rawPath];
  if (config) {
    document.title = `${config.title} — I LOVE FILES`;
    switchTab(config.view, true);
    if (config.view === 'convert') {
      if (config.quickTool && typeof setQuickTool === 'function') {
        setQuickTool(config.quickTool);
      }
      if (config.dropTitle) {
        const dt = document.getElementById('convert-drop-title');
        if (dt) dt.innerText = config.dropTitle;
      }
      if (config.dropDesc) {
        const dd = document.getElementById('convert-drop-desc');
        if (dd) dd.innerText = config.dropDesc;
      }
    }
  }

  if (window.lucide) lucide.createIcons();
}

window.addEventListener('popstate', handleRoute);

function setupHeroInstantDropzone() {
  const dropzone = document.getElementById('hero-instant-dropzone');
  const fileInput = document.getElementById('hero-instant-input');
  if (!dropzone) return;

  ['dragenter', 'dragover'].forEach(evt => {
    dropzone.addEventListener(evt, (e) => {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });
  });

  ['dragleave', 'drop'].forEach(evt => {
    dropzone.addEventListener(evt, (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
    });
  });

  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer.files.length) {
      handleHeroInstantFiles(e.dataTransfer.files);
    }
  });

  if (fileInput) {
    fileInput.addEventListener('change', (e) => {
      if (e.target.files.length) {
        handleHeroInstantFiles(e.target.files);
      }
    });
  }
}

function handleHeroInstantFiles(files) {
  if (!files || !files.length) return;
  const file = files[0];
  const ext = getFileExtension(file.name).toLowerCase();

  if (files.length > 1) {
    navigateTo('/merge-pdf');
    setTimeout(() => {
      if (typeof handleMergeFilesSelect === 'function') handleMergeFilesSelect(files);
    }, 120);
    return;
  }

  if (ext === 'dwg' || ext === 'dxf') {
    navigateTo('/dwg-to-pdf');
    setTimeout(() => {
      if (typeof handlePlotFilesSelect === 'function') handlePlotFilesSelect(files);
    }, 120);
  } else if (ext === 'pdf') {
    navigateTo('/compress-pdf');
    setTimeout(() => {
      if (typeof handleResizeFileSelect === 'function') handleResizeFileSelect(files);
    }, 120);
  } else if (['doc', 'docx'].includes(ext)) {
    navigateTo('/word-to-pdf');
    setTimeout(() => {
      if (typeof handleConvertFileSelect === 'function') handleConvertFileSelect(files);
    }, 120);
  } else if (['xls', 'xlsx'].includes(ext)) {
    navigateTo('/excel-to-pdf');
    setTimeout(() => {
      if (typeof handleConvertFileSelect === 'function') handleConvertFileSelect(files);
    }, 120);
  } else if (['ppt', 'pptx'].includes(ext)) {
    navigateTo('/powerpoint-to-pdf');
    setTimeout(() => {
      if (typeof handleConvertFileSelect === 'function') handleConvertFileSelect(files);
    }, 120);
  } else if (['jpg', 'jpeg', 'png', 'webp', 'gif', 'bmp', 'tiff', 'svg'].includes(ext)) {
    navigateTo('/image-converter');
    setTimeout(() => {
      if (typeof handleConvertFileSelect === 'function') handleConvertFileSelect(files);
    }, 120);
  } else if (['mp4', 'mkv', 'mov', 'avi', 'mp3', 'wav', 'flac'].includes(ext)) {
    navigateTo('/video-converter');
    setTimeout(() => {
      if (typeof handleConvertFileSelect === 'function') handleConvertFileSelect(files);
    }, 120);
  } else {
    navigateTo('/pdf-to-word');
    setTimeout(() => {
      if (typeof handleConvertFileSelect === 'function') handleConvertFileSelect(files);
    }, 120);
  }
}

// -------------------------------------------------------------
// Tab Switching
// -------------------------------------------------------------
function switchTab(tabId, shouldScroll = false) {
  ["convert", "plot", "merge", "resize"].forEach(t => {
    const view = document.getElementById(`view-${t}`);
    const btn = document.getElementById(`tab-btn-${t}`);
    if (view) {
      view.style.display = (t === tabId) ? "block" : "none";
      view.classList.toggle("active", t === tabId);
    }
    if (btn) btn.classList.toggle("active", t === tabId);
  });
  if (shouldScroll) {
    const bento = document.getElementById("studio-bento");
    if (bento) bento.scrollIntoView({ behavior: "smooth" });
  }
  lucide.createIcons();
}

function switchResizeSubTab(type) {
  activeResizeType = type;
  ["pdf", "image", "video"].forEach(st => {
    const btn = document.getElementById(`resize-subtab-${st}`);
    const ctrl = document.getElementById(`controls-${st}`);
    if (btn) btn.classList.toggle("active", st === type);
    if (ctrl) ctrl.style.display = (st === type) ? "block" : "none";
  });

  const title = document.getElementById("resize-drop-title");
  const desc = document.getElementById("resize-drop-desc");
  if (type === "pdf") {
    title.innerText = "Choose PDF to resize";
    desc.innerText = "Normalizes page dimensions (A4, Letter) and compresses file size";
  } else if (type === "image") {
    title.innerText = "Choose Image to resize";
    desc.innerText = "Custom width, height, and quality compression (PNG, JPG, WebP)";
  } else if (type === "video") {
    title.innerText = "Choose Video to downscale";
    desc.innerText = "Scales 4K/1080p to 720p/480p and compresses bitrate (MP4, MKV, MOV)";
  }
  lucide.createIcons();
}

// -------------------------------------------------------------
// Drag and Drop
// -------------------------------------------------------------
function setupDragAndDrop() {
  const convertZone = document.getElementById("convert-dropzone");
  const plotZone = document.getElementById("plot-dropzone");
  const mergeZone = document.getElementById("merge-dropzone");
  const resizeZone = document.getElementById("resize-dropzone");

  [convertZone, plotZone, mergeZone, resizeZone].forEach(zone => {
    if (!zone) return;
    ['dragenter', 'dragover'].forEach(evt => {
      zone.addEventListener(evt, (e) => { e.preventDefault(); zone.classList.add('dragover'); });
    });
    ['dragleave', 'drop'].forEach(evt => {
      zone.addEventListener(evt, (e) => { e.preventDefault(); zone.classList.remove('dragover'); });
    });
  });

  if (convertZone) {
    convertZone.addEventListener('drop', (e) => {
      if (e.dataTransfer.files.length) handleConvertFileSelect(e.dataTransfer.files);
    });
  }
  if (plotZone) {
    plotZone.addEventListener('drop', (e) => {
      if (e.dataTransfer.files.length) handlePlotFilesSelect(e.dataTransfer.files);
    });
  }
  if (mergeZone) {
    mergeZone.addEventListener('drop', (e) => {
      if (e.dataTransfer.files.length) handleMergeFilesSelect(e.dataTransfer.files);
    });
  }
  if (resizeZone) {
    resizeZone.addEventListener('drop', (e) => {
      if (e.dataTransfer.files.length) handleResizeFileSelect(e.dataTransfer.files);
    });
  }
}

// -------------------------------------------------------------
// UI Error Notifications
// -------------------------------------------------------------
function showError(prefix, message) {
  const banner = document.getElementById(`${prefix}-error-banner`);
  const text = document.getElementById(`${prefix}-error-text`);
  if (banner && text) {
    text.innerText = message;
    banner.style.display = "flex";
    lucide.createIcons();
  }
}

function hideError(prefix) {
  const banner = document.getElementById(`${prefix}-error-banner`);
  if (banner) banner.style.display = "none";
}

