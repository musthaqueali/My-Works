  'word-to-pdf': 'pdf',
  'excel-to-pdf': 'pdf',
  'ppt-to-pdf': 'pdf',
  'jpg-to-pdf': 'pdf',
  'png-to-pdf': 'pdf',
  'heic-to-pdf': 'pdf',
  'autocad-to-pdf': 'pdf',
  'openoffice-to-pdf': 'pdf',
  'ebook-to-pdf': 'pdf',
  'iwork-to-pdf': 'pdf',
  'publisher-to-pdf': 'pdf',
  'dicom-to-pdf': 'pdf',
  'pdf-to-word': 'docx',
  'pdf-to-excel': 'xlsx',
  'pdf-to-pptx': 'pptx',
  'pdf-to-jpg': 'jpg',
  'pdf-to-png': 'png',
  'pdf-to-pdfa': 'pdf',
  'dwg-to-dwf': 'dwf',
  'dwf-to-dwg': 'dwg',
  'dwg-to-dxf': 'dxf',
  'dxf-to-dwg': 'dwg',
  'pdf-to-cad': 'dwg',
  'audio-to-mp3': 'mp3',
  'audio-to-wav': 'wav',
  'audio-to-flac': 'flac',
  'audio-to-m4a': 'm4a',
  'video-to-mp4': 'mp4',
