# AI Newsletter Platform Environment Configuration

NEWSLETTER_NAME="The AI Dispatch"
NEWSLETTER_TAGLINE="High-signal AI intelligence for engineers, builders, and leaders"

# Email Delivery Provider: "simulation", "smtp", or "resend"
# "simulation" logs outgoing emails locally (ideal for testing without credentials)
# "smtp" sends via Gmail / Outlook / corporate mail server
# "resend" sends via Resend REST API (https://resend.com)
EMAIL_PROVIDER=simulation

# Sender information
FROM_EMAIL=your_email@gmail.com
FROM_NAME="The AI Dispatch"

# SMTP Settings (Required if EMAIL_PROVIDER=smtp)
# For Gmail: Use an App Password (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true

# Resend API Settings (Required if EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_1234567890abcdef

# Optional LLM API Key for real-time web AI synthesis
GEMINI_API_KEY=
OPENAI_API_KEY=
