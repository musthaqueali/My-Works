# ==========================================
# PUCDesk Cloud Environment Configuration
# ==========================================

# Server Settings
PORT=8000
HOST=0.0.0.0

# Database Settings
# For local development: uses SQLite
DATABASE_FILE=puc_desk.db
# For Azure Production: Azure Database for PostgreSQL (Flexible Server) or Azure SQL
# DATABASE_URL=postgresql://pucadmin:YourPassword@pucdesk-db.postgres.database.azure.com:5432/pucdesk

# Cashfree Payment Gateway Credentials
# Environment: TEST (Sandbox) or PROD (Production)
CASHFREE_ENV=TEST
CASHFREE_APP_ID=TEST103409458923b0b7...
CASHFREE_SECRET_KEY=cfsk_ma_test_019485...
CASHFREE_RETURN_URL=https://your-puc-app.azurewebsites.net/

# SMS & WhatsApp Gateway Settings
# Provider options: Fast2SMS, MSG91, or Meta Cloud WhatsApp API
SMS_API_KEY=your_sms_or_dlt_api_key_here
SMS_SENDER_ID=AIRPOL-KL
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
